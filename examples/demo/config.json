{
  "$schema": "../../Sources/SbarCore/Resources/config.schema.json",
  "schemaVersion": 2,
  "bar": {
    "position": "bottom",
    "height": 38,
    "displays": "all",
    "windowLevel": "statusBar",
    "mousePassThrough": true
  },
  "theme": {
    "background": "#18202EF2",
    "horizontalPadding": 12,
    "itemSpacing": 6,
    "itemStyle": {
      "tint": "#E5E9F0",
      "fontSize": 12,
      "fontWeight": "medium",
      "horizontalPadding": 6,
      "verticalPadding": 3,
      "cornerRadius": 6
    }
  },
  "items": {
    "left": [
      {
        "id": "demo",
        "type": "popup",
        "label": "sbar",
        "symbol": "sparkles",
        "priority": 100,
        "style": {
          "tint": "#88C0D0",
          "background": "#88C0D022",
          "fontWeight": "bold"
        },
        "popup": "Demo bar \u00b7 native providers, actions, commands and plugins",
        "children": [
          {
            "id": "finder",
            "type": "text",
            "label": "Open Finder",
            "symbol": "folder",
            "primaryAction": {
              "kind": "application",
              "value": "com.apple.finder"
            }
          },
          {
            "id": "settings",
            "type": "text",
            "label": "System Settings",
            "symbol": "gearshape",
            "primaryAction": {
              "kind": "application",
              "value": "com.apple.systempreferences"
            }
          },
          {
            "id": "website",
            "type": "text",
            "label": "Apple Developer",
            "symbol": "globe",
            "primaryAction": {
              "kind": "url",
              "value": "https://developer.apple.com"
            }
          },
          {
            "id": "shell-action",
            "type": "text",
            "label": "Open home folder (shell action)",
            "symbol": "terminal",
            "primaryAction": {
              "kind": "command",
              "value": "/usr/bin/open \"$HOME\""
            }
          }
        ]
      },
      {
        "id": "left-divider",
        "type": "divider",
        "priority": 80
      },
      {
        "id": "front-app",
        "type": "frontApplication",
        "symbol": "app",
        "priority": 90,
        "refresh": {
          "mode": "event"
        },
        "secondaryAction": {
          "kind": "application",
          "value": "com.apple.ActivityMonitor"
        }
      },
      {
        "id": "host",
        "type": "command",
        "symbol": "desktopcomputer",
        "priority": -10,
        "command": {
          "script": "/bin/hostname -s",
          "timeout": 2
        },
        "refresh": {
          "mode": "manual",
          "event": "demo-refresh"
        },
        "popup": "Hostname runs at startup. Trigger demo-refresh to run it again."
      },
      {
        "id": "spaces",
        "type": "spaces",
        "symbol": "rectangle.3.group",
        "priority": 70
      },
      {
        "id": "aerospace",
        "type": "aerospace",
        "enabled": false,
        "priority": 70
      },
      {
        "id": "yabai",
        "type": "yabai",
        "enabled": false,
        "priority": 70
      }
    ],
    "center": [
      {
        "id": "media",
        "type": "media",
        "symbol": "music.note",
        "priority": 10,
        "style": {
          "tint": "#B48EAD"
        },
        "popup": "Music and Spotify update this item on playback notifications. Start or change a track after launching the bar."
      },
      {
        "id": "stream",
        "type": "plugin",
        "symbol": "waveform.path",
        "priority": -10,
        "style": {
          "tint": "#A3BE8C"
        },
        "plugin": {
          "executable": "/bin/sh",
          "arguments": [
            "-c",
            "count=0; while IFS= read -r event; do count=$((count + 1)); printf '{\"text\":\"Events %s\"}\\n' \"$count\"; done"
          ],
          "restart": true
        },
        "popup": "A tiny JSON-lines plugin. Counts the start event and each runtime trigger."
      }
    ],
    "right": [
      {
        "id": "metrics",
        "type": "group",
        "priority": 30,
        "style": {
          "background": "#FFFFFF0C",
          "horizontalPadding": 0,
          "verticalPadding": 0
        },
        "children": [
          {
            "id": "cpu",
            "type": "cpu",
            "style": {
              "tint": "#88C0D0"
            }
          },
          {
            "id": "memory",
            "type": "memory",
            "style": {
              "tint": "#B48EAD"
            }
          }
        ]
      },
      {
        "id": "system",
        "type": "popup",
        "label": "System",
        "symbol": "slider.horizontal.3",
        "priority": 80,
        "children": [
          {
            "id": "disk",
            "type": "disk"
          },
          {
            "id": "network",
            "type": "network"
          },
          {
            "id": "wifi",
            "type": "wifi"
          },
          {
            "id": "throughput",
            "type": "throughput"
          },
          {
            "id": "uptime",
            "type": "command",
            "command": {
              "script": "/usr/bin/uptime",
              "timeout": 2
            },
            "refresh": {
              "mode": "interval",
              "seconds": 60,
              "event": "demo-refresh"
            }
          },
          {
            "id": "snapshot",
            "type": "clock",
            "symbol": "camera",
            "format": "HH:mm:ss",
            "refresh": {
              "mode": "manual",
              "event": "demo-refresh"
            },
            "popup": "This clock is a snapshot: trigger demo-refresh to capture the current time."
          },
          {
            "id": "activity-monitor",
            "type": "text",
            "label": "Open Activity Monitor",
            "symbol": "chart.xyaxis.line",
            "primaryAction": {
              "kind": "application",
              "value": "com.apple.ActivityMonitor"
            }
          }
        ]
      },
      {
        "id": "volume",
        "type": "volume",
        "priority": 20
      },
      {
        "id": "battery",
        "type": "battery",
        "priority": 50
      },
      {
        "id": "date",
        "type": "date",
        "priority": -20,
        "primaryAction": {
          "kind": "application",
          "value": "com.apple.iCal"
        }
      },
      {
        "id": "right-divider",
        "type": "divider",
        "priority": 90
      },
      {
        "id": "clock",
        "type": "clock",
        "format": "HH:mm:ss",
        "symbol": "clock",
        "priority": 100,
        "style": {
          "tint": "#EBCB8B",
          "background": "#EBCB8B18"
        },
        "primaryAction": {
          "kind": "application",
          "value": "com.apple.iCal"
        },
        "popup": "Click opens Calendar. Right-click offers System Settings.",
        "secondaryAction": {
          "kind": "application",
          "value": "com.apple.systempreferences"
        }
      }
    ]
  }
}
