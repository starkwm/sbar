{
  "$schema": "../../Sources/SbarCore/Resources/config.schema.json",
  "schemaVersion": 1,
  "bar": {
    "position": "top",
    "height": 38,
    "displays": "all",
    "margin": { "top": 0, "bottom": 8, "left": 0, "right": 0 },
    "shadow": true,
    "mousePassThrough": true
  },
  "theme": {
    "background": "#1A1B26F5",
    "horizontalPadding": 10,
    "verticalPadding": 4,
    "cornerRadius": 0,
    "itemSpacing": 6,
    "itemStyle": {
      "fontSize": 12,
      "fontWeight": "medium",
      "horizontalPadding": 8,
      "verticalPadding": 4,
      "cornerRadius": 7
    }
  },
  "items": {
    "left": [
      {
        "id": "spaces",
        "type": "spaces",
        "spaces": { "scope": "display", "format": "current" },
        "priority": 40,
        "style": { "tint": "#7AA2F7" },
        "primaryAction": { "kind": "application", "value": "com.apple.exposelauncher" }
      },
      {
        "id": "front-app",
        "type": "frontApplication",
        "priority": 80,
        "style": { "tint": "#C0CAF5", "fontWeight": "semibold" }
      },
      {
        "id": "media",
        "type": "media",
        "priority": 10,
        "media": { "separator": " · ", "hideWhenNotPlaying": true },
        "style": { "tint": "#FF9E64" }
      }
    ],
    "center": [],
    "right": [
      {
        "id": "memory",
        "type": "memory",
        "priority": 20,
        "memory": { "format": "percentage", "showLabel": false },
        "style": { "tint": "#7AA2F7", "background": "#292E42" },
        "primaryAction": { "kind": "application", "value": "com.apple.ActivityMonitor" }
      },
      {
        "id": "cpu",
        "type": "cpu",
        "priority": 20,
        "cpu": {
          "showLabel": false,
          "smoothingSamples": 3,
          "tints": { "medium": "#E0AF68", "high": "#F7768E" }
        },
        "style": { "tint": "#BB9AF7", "background": "#292E42" },
        "popup": "System",
        "children": [
          {
            "id": "cpu-detail",
            "type": "cpu",
            "cpu": { "smoothingSamples": 3 }
          },
          {
            "id": "memory-detail",
            "type": "memory",
            "memory": { "format": "usedTotal" }
          },
          {
            "id": "disk",
            "type": "disk"
          },
          {
            "id": "activity-monitor",
            "type": "text",
            "label": "Open Activity Monitor",
            "symbol": "chart.xyaxis.line",
            "primaryAction": { "kind": "application", "value": "com.apple.ActivityMonitor" }
          }
        ]
      },
      {
        "id": "vpn",
        "type": "vpn",
        "priority": 70,
        "vpn": {
          "showLabel": false,
          "hideWhenDisconnected": true,
          "tints": {
            "connected": "#9ECE6A",
            "connecting": "#E0AF68",
            "disconnecting": "#FF9E64",
            "unavailable": "#F7768E"
          }
        },
        "style": { "tint": "#A9B1D6" },
        "primaryAction": { "kind": "application", "value": "com.apple.systempreferences" }
      },
      {
        "id": "network",
        "type": "network",
        "priority": 60,
        "network": { "showLabel": false, "tints": { "offline": "#F7768E" } },
        "style": { "tint": "#7DCFFF" },
        "popup": "Connections",
        "children": [
          {
            "id": "network-detail",
            "type": "network",
            "network": {
              "labels": {
                "wifi": "Wi-Fi connected",
                "ethernet": "Ethernet connected",
                "cellular": "Cellular connected",
                "other": "Network connected"
              }
            }
          },
          {
            "id": "vpn-detail",
            "type": "vpn"
          },
          {
            "id": "throughput",
            "type": "throughput",
            "throughput": { "smoothingSamples": 3 }
          },
          {
            "id": "network-settings",
            "type": "text",
            "label": "Open System Settings",
            "symbol": "gearshape",
            "primaryAction": { "kind": "application", "value": "com.apple.systempreferences" }
          }
        ]
      },
      {
        "id": "sound",
        "type": "volume",
        "priority": 50,
        "volume": { "showPercentage": false, "tints": { "muted": "#E0AF68" } },
        "style": { "tint": "#73DACA" },
        "popup": "Sound",
        "children": [
          {
            "id": "volume",
            "type": "volume"
          },
          {
            "id": "volume-controls",
            "type": "group",
            "style": { "horizontalPadding": 0, "verticalPadding": 0 },
            "children": [
              {
                "id": "volume-down",
                "type": "text",
                "label": "Lower",
                "symbol": "minus",
                "style": { "background": "#737AA218" },
                "primaryAction": {
                  "kind": "command",
                  "value": "/usr/bin/osascript -e 'set level to output volume of (get volume settings)' -e 'if level < 10 then set level to 10' -e 'set volume output volume (level - 10)'"
                }
              },
              {
                "id": "volume-mute",
                "type": "text",
                "label": "Mute / unmute",
                "symbol": "speaker.slash",
                "style": { "background": "#737AA218" },
                "primaryAction": {
                  "kind": "command",
                  "value": "/usr/bin/osascript -e 'set volume output muted (not (output muted of (get volume settings)))'"
                }
              },
              {
                "id": "volume-up",
                "type": "text",
                "label": "Raise",
                "symbol": "plus",
                "style": { "background": "#737AA218" },
                "primaryAction": {
                  "kind": "command",
                  "value": "/usr/bin/osascript -e 'set level to output volume of (get volume settings)' -e 'if level > 90 then set level to 90' -e 'set volume output volume (level + 10)'"
                }
              }
            ]
          },
          {
            "id": "output",
            "type": "audioDevice"
          },
          {
            "id": "input",
            "type": "audioDevice",
            "audioDevice": { "device": "input" }
          },
          {
            "id": "sound-settings",
            "type": "text",
            "label": "Open System Settings",
            "symbol": "gearshape",
            "primaryAction": { "kind": "application", "value": "com.apple.systempreferences" }
          }
        ]
      },
      {
        "id": "battery",
        "type": "battery",
        "priority": 80,
        "battery": {
          "lowThreshold": 20,
          "tints": { "low": "#F7768E", "charging": "#9ECE6A" }
        },
        "style": { "tint": "#C0CAF5" },
        "primaryAction": { "kind": "application", "value": "com.apple.systempreferences" }
      },
      {
        "id": "date",
        "type": "datetime",
        "format": "EEEE, d MMMM",
        "priority": -10,
        "style": { "tint": "#A9B1D6" },
        "primaryAction": { "kind": "application", "value": "com.apple.iCal" }
      },
      {
        "id": "clock",
        "type": "datetime",
        "format": "HH:mm",
        "priority": 100,
        "style": {
          "tint": "#7AA2F7",
          "background": "#292E42",
          "fontWeight": "semibold",
          "horizontalPadding": 10
        },
        "popup": "Today",
        "children": [
          {
            "id": "full-date",
            "type": "datetime",
            "dateStyle": "full"
          },
          {
            "id": "calendar",
            "type": "text",
            "label": "Open Calendar",
            "symbol": "calendar",
            "primaryAction": { "kind": "application", "value": "com.apple.iCal" }
          },
          {
            "id": "reminders",
            "type": "text",
            "label": "Open Reminders",
            "symbol": "checklist",
            "primaryAction": { "kind": "application", "value": "com.apple.reminders" }
          }
        ]
      }
    ]
  }
}
