{
  "$schema": "../../Sources/SbarCore/Resources/config.schema.json",
  "schemaVersion": 1,
  "bar": {
    "position": "top",
    "height": 38,
    "displays": "all",
    "margin": { "top": 0, "bottom": 8, "left": 0, "right": 0 },
    "shadow": true,
    "mousePassThrough": true
  },
  "theme": {
    "background": "#1A1B26F5",
    "horizontalPadding": 10,
    "verticalPadding": 4,
    "cornerRadius": 0,
    "itemSpacing": 6,
    "itemStyle": {
      "hoverTint": "#FFFFFF",
      "hoverBackground": "#414868",
      "fontSize": 12,
      "fontWeight": "medium",
      "horizontalPadding": 8,
      "verticalPadding": 4,
      "cornerRadius": 7
    }
  },
  "items": {
    "left": [
      {
        "id": "spaces",
        "type": "spaces",
        "priority": 40,
        "style": {
          "tint": "#7AA2F7",
          "background": "#292E42"
        },
        "spaces": {
          "scope": "display",
          "format": "current"
        }
      },
      {
        "id": "front-app",
        "type": "frontApplication",
        "priority": 80,
        "style": {
          "tint": "#C0CAF5",
          "fontWeight": "semibold"
        },
        "frontApplication": {
          "showIcon": true
        }
      },
      {
        "id": "media",
        "type": "media",
        "priority": 10,
        "style": {
          "tint": "#FF9E64"
        },
        "media": {
          "separator": " · ",
          "hideWhenNotPlaying": true
        }
      }
    ],
    "right": [
      {
        "id": "cpu",
        "type": "cpu",
        "priority": 20,
        "symbolPosition": "right",
        "style": {
          "tint": "#BB9AF7",
          "background": "#292E42",
          "minWidth": 65
        },
        "cpu": {
          "showLabel": false,
          "smoothingSamples": 3,
          "tints": {
            "medium": "#E0AF68",
            "high": "#F7768E"
          }
        },
        "primaryAction": {
          "kind": "application",
          "value": "com.apple.ActivityMonitor"
        }
      },
      {
        "id": "memory",
        "type": "memory",
        "priority": 20,
        "symbolPosition": "right",
        "style": {
          "tint": "#7AA2F7",
          "background": "#292E42",
          "minWidth": 65,
          "alignment": "center"
        },
        "memory": {
          "format": "percentage",
          "showLabel": false
        },
        "primaryAction": {
          "kind": "application",
          "value": "com.apple.ActivityMonitor"
        }
      },
      {
        "id": "vpn",
        "type": "vpn",
        "priority": 70,
        "vpn": {
          "showLabel": false,
          "hideWhenDisconnected": false,
          "tints": {
            "connected": "#9ECE6A",
            "connecting": "#E0AF68",
            "disconnecting": "#FF9E64",
            "unavailable": "#F7768E"
          }
        },
        "style": {
          "tint": "#A9B1D6"
        },
        "primaryAction": {
          "kind": "command",
          "value": "open 'x-apple.systempreferences:com.apple.NetworkExtensionSettingsUI.NESettingsUIExtension'"
        }
      },
      {
        "id": "network",
        "type": "network",
        "priority": 60,
        "style": {
          "tint": "#7DCFFF"
        },
        "network": {
          "showLabel": false,
          "tints": {
            "offline": "#F7768E"
          }
        },
        "popup": "Connections",
        "children": [
          {
            "id": "network-detail",
            "type": "network",
            "network": {
              "labels": {
                "wifi": "Wi-Fi connected",
                "ethernet": "Ethernet connected",
                "cellular": "Cellular connected",
                "other": "Network connected"
              }
            }
          },
          {
            "id": "vpn-detail",
            "type": "vpn"
          },
          {
            "id": "throughput",
            "type": "throughput",
            "throughput": { "smoothingSamples": 3 }
          }
        ]
      },
      {
        "id": "sound",
        "type": "volume",
        "priority": 50,
        "style": {
          "tint": "#73DACA"
        },
        "volume": {
          "showPercentage": false,
          "tints": {
            "muted": "#E0AF68"
          }
        },
        "popup": "Sound",
        "children": [
          {
            "id": "volume",
            "type": "volume"
          },
          {
            "id": "output",
            "type": "audioDevice"
          },
          {
            "id": "input",
            "type": "audioDevice",
            "audioDevice": { "device": "input" }
          }
        ]
      },
      {
        "id": "battery",
        "type": "battery",
        "priority": 80,
        "symbolPosition": "right",
        "style": {
          "tint": "#C0CAF5"
        },
        "battery": {
          "lowThreshold": 20,
          "tints": {
            "low": "#F7768E",
            "charging": "#9ECE6A"
          }
        }
      },
      {
        "id": "date",
        "type": "datetime",
        "format": "EE, d MMM",
        "priority": -10,
        "style": { "tint": "#A9B1D6" }
      },
      {
        "id": "clock",
        "type": "datetime",
        "format": "HH:mm",
        "priority": 100,
        "style": {
          "tint": "#7AA2F7",
          "background": "#292E42",
          "fontWeight": "semibold",
          "horizontalPadding": 10
        }
      }
    ]
  }
}
